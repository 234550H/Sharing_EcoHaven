import React, { useState, useEffect, useRef } from "react";
import { useLocation } from "react-router-dom";
import axios from "axios";
import QRCode from "qrcode.react";
import '../../src/assets/style/frontend/ConfirmationPage.css';
import Navbar from '../../components/navbar';
import Footer from '../../components/footer';

const ConfirmationPage = () => {
  const location = useLocation();
  const { id, ...formData } = location.state || {};
  const [qrCodeText, setQrCodeText] = useState("");
  const [qrCodeDataUrl, setQrCodeDataUrl] = useState("");
  const qrCodeRef = useRef(null);
  const paxArray = Array.from({ length: formData.numberOfPax }, (_, index) => index + 1);
  const [alertMessage, setAlertMessage] = useState('');
  const [alertType, setAlertType] = useState('info');
  const [showAlert, setShowAlert] = useState(false);

  useEffect(() => {
    const fetchBookingDetails = async () => {
      try {
        const response = await axios.get(`http://localhost:3001/api/bookings/${id}`);
        setQrCodeText(response.data.qrCodeText);
      } catch (error) {
        console.error('Error fetching booking details:', error);
      }
    };

    if (id) {
      fetchBookingDetails();
    }
  }, [id]);

  useEffect(() => {
    if (qrCodeRef.current) {
      const canvas = qrCodeRef.current.querySelector("canvas");
      if (canvas) {
        const dataUrl = canvas.toDataURL("image/png");
        setQrCodeDataUrl(dataUrl);
      }
    }
  }, [qrCodeText]);

  const handleDownloadQRCode = () => {
    if (qrCodeRef.current !== null) {
      const canvas = qrCodeRef.current.querySelector("canvas");
      const url = canvas.toDataURL("image/png");

      const link = document.createElement("a");
      link.href = url;
      link.download = "Ecohaven Event qr-code.png";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  };

  const handleReceiveBookingDetails = async () => {
    const success = await sendEmail(formData);
    if (success) {
      handleShowAlert('Email sent successfully', 'success');
    } else {
      handleShowAlert('Failed to send email', 'error');
    }
  };

  const handleShowAlert = (message, type = 'info') => {
    setAlertMessage(message);
    setAlertType(type);
    setShowAlert(true);

    // Auto hide the alert after 5 seconds
    setTimeout(() => {
      setShowAlert(false);
    }, 5000);
  };

  const sendEmail = async (formData) => {
    const url = 'http://localhost:3001/send-email';
    const data = {
      to: ["ecohaven787@gmail.com", "workpjtqf@gmail.com"],
      subject: 'Booking Event Confirmation',
      text: 'Your booking has been made successful! Please find your event information below. This is an autogenerated email copy of your event details.',
      html: `
        <html>
          <body>
             <div style="background-color: green; color: white; text-align: center; padding: 10px;"><span style="color:white; font-weight:bold;font-size:20px;">Eco</span><span style="color:black;font-weight:bold;font-size:20px;">Haven</span></div>
            <h2>Booking Details</h2>
            <h4>Greetings <strong>${formData.firstName} ${formData.lastName}</strong>! Thank you for signing up our events! Please find the below information as your booking details, we're thrilled to see you there!</h4>
            <p>Event: <strong>${formData.event}</strong></p>
            <p>Phone Number: <strong>${formData.phoneNumber}</strong></p>
            <p>Email: <strong>${formData.email}</strong></p>
            <p>Date: <strong>${formData.bookingDate ? new Date(formData.bookingDate).toLocaleDateString('en-GB') : 'N/A'}</strong></p>
            <p>Number of Pax: <strong>${formData.numberOfPax}</strong></p>
            <p>Location: <strong>Dummy Text for now</strong></p>
            <p>Admission: <strong>Free</strong></p>
            <p>Here is your QR Code text: <strong>${qrCodeText}</strong></p>
            <p>To check in on the actual day, give your generated QR code text to the in-charge. You can download the QR Code image for convenience from your account bookings page.</p>
            <i><b>This is an email auto generated node mailer from ECOHAVEN</b></i>
          </body>
        </html>
      `,
    };
  
  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data),
    });

    if (response.ok) {
      handleShowAlert('Email sent successfully');
      return true;
    } else {
      handleShowAlert('Failed to send email');
      return false;
    }
  } catch (error) {
    handleShowAlert('Error sending email:', error);
    return false;
  }
};

  return (

    <div className="overcontainer">
        <Navbar />
      <div className="headbanner">
        <h1 style={{marginTop:'120px'}}>Booking Confirmation</h1>
      </div>
      <img src="../src/assets/icons/home.png" alt="Home" style={{ width: '30px', marginLeft: '30px', marginRight: '10px', marginTop: '15px' }} /><a href="/"><u>Home</u></a>
      <h4 className="h4">YOUR TICKET(S) ARE CONFIRMED</h4>
      <section>
        <img src="../src/assets/images/sucessful_mascot.png" className="mascot"></img>
        <h4 className="caption">  Booking has been made successfully!</h4>
        <h4 className="caption" style={{ marginTop: '-180px', fontSize: '20px', marginLeft: '410px', color: 'black' }}>Click below to recieve your booking details</h4>
        <button onClick={handleReceiveBookingDetails} className="mail">Receive Booking Details</button>
      {showAlert && <div className={`alert ${alertType}`}>{alertMessage}</div>}
      </section>
      <p className="bookingid"><strong>------------ Booking ID: {id}------------</strong></p>
      <div className="bg">
        <article>
          <p className="pstyle"> {formData.event}</p>
          <p>Name:<strong> {formData.firstName} {formData.lastName}</strong></p>
          <p> Phone Number:<strong> {formData.phoneNumber}</strong></p>
          <p>Email:<strong> {formData.email}</strong></p>
          <p>Date:<strong>{formData.bookingDate ? new Date(formData.bookingDate).toLocaleDateString('en-GB') : 'N/A'}</strong></p>
          <p>Number of Pax:<strong> {formData.numberOfPax}</strong></p>
          <p>Location:<strong> Dummy Text for now</strong></p>
          <p>Admission:<strong> Free</strong></p>
          <img src="../src/assets/images/event1.jpg" className="eventimg"/>
        </article>
        <div className="tickets">
          <h5>TICKETS</h5>
          <hr/>
          <p style={{fontSize:'20px'}}><u>No. of Pax ({formData.numberOfPax}) </u></p>
          <div>
            {paxArray.map(pax => (
              <p key={pax}>Pax: {pax} <span style={{marginLeft:'600px',fontSize:'20px'}}>$0.00</span></p>
            ))}
          </div>
        </div>
        <h5 className="total" style={{fontSize:'23px'}}>TOTAL <span style={{marginLeft:'579px'}}>$0.00</span></h5>
      </div>
      <h5 style={{marginLeft:'520px',marginTop:'450px',textAlign:'center',width:'500px'}}>QR-CODE: Flash this to check in</h5>
      <div className="QRCODE">
        <h5 style={{textAlign:'center',marginTop:'20px'}}>Event Ticket</h5>
        <div id="qrcode-canvas" ref={qrCodeRef} style={{marginTop:'-45px',marginLeft:'50px'}}>
          <QRCode
            value={qrCodeText}
            size={230}
            fgColor="black"
            level="L"
            includeMargin={true}
            imageSettings={{
              src: "./favicon.ico",
              x: undefined,
              y: undefined,
              height: 50,
              width: 50,
              excavate: false,
            }}
          />
          <p style={{marginLeft:'300px',marginTop:'-210px',fontSize:'20px'}}><strong>QR Code ID:</strong> {qrCodeText}</p>
          <p style={{marginLeft:'300px',fontSize:'20px'}}><strong>Venue:</strong> Cheng San CC (example)</p>
        </div>
        <button onClick={handleDownloadQRCode} className="download">Download</button>
      </div>
      <div className="foot">
        <Footer />
      </div>
    </div>
  );
};

export default ConfirmationPage;
